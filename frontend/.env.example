# ==============================================================================
# Cipher Vault Frontend - Environment Configuration
# ==============================================================================

# Backend REST API Base URL
# When deployed on Vercel: Set to your Render backend URL (e.g. https://cipher-vault-api.onrender.com)
# When running locally: Leave empty or omit to use Vite's built-in /api dev proxy (http://127.0.0.1:5000)
VITE_API_URL=https://cipher-vault-api.onrender.com

# Backend Real-Time Socket.io URL (Optional)
# If omitted or empty, SocketContext automatically falls back to VITE_API_URL (or window.location.origin locally)
VITE_SOCKET_URL=https://cipher-vault-api.onrender.com

# Local AI Microservice URL (FastAPI + SentenceTransformers + ChromaDB + Ollama)
# CRITICAL ZERO-TRUST REQUIREMENT: This pipeline ALWAYS runs locally on the user's client machine.
# Document decryption keys and decrypted plaintext are NEVER sent to Render, Vercel, or cloud LLMs.
VITE_LOCAL_AI_URL=http://127.0.0.1:8000
