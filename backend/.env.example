# ==============================================================================
# Cipher Vault Backend - Environment Configuration
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=production

# Server Port (Render sets this automatically via process.env.PORT)
PORT=5000

# MongoDB Database Connection
# Local: mongodb://127.0.0.1:27017/cipher_vault
# Production (MongoDB Atlas): mongodb+srv://<username>:<password>@<cluster>.mongodb.net/cipher_vault?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://db_user:secure_password@cluster0.mongodb.net/cipher_vault?retryWrites=true&w=majority

# Client Origins for CORS and WebSocket connections
# Supports comma-separated origins and wildcard subdomains (e.g. *.vercel.app)
# Local: http://localhost:3000
# Production: https://cipher-vault.vercel.app,https://*.vercel.app
CLIENT_ORIGIN=https://cipher-vault.vercel.app,https://*.vercel.app,http://localhost:3000

# Security Secrets (Must be at least 32 characters; MFA key must be exactly 64 hex chars)
# Generate via: openssl rand -hex 32
JWT_ACCESS_SECRET=replace_with_min_32_char_random_access_secret_123456
JWT_REFRESH_SECRET=replace_with_min_32_char_random_refresh_secret_12345
# Optional: Generic JWT_SECRET fallback (if set on Render, access & refresh keys derive from it)
# JWT_SECRET=replace_with_min_32_char_random_secret_for_render_dashboard

# MFA Encryption Key (AES-256-GCM encryption of user TOTP secrets)
# Exactly 64 hex characters (32 bytes). Generate via: openssl rand -hex 32
MFA_ENC_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# HMAC Audit Integrity Key (Append-only SHA256 audit chaining)
# Minimum 32 characters. Generate via: openssl rand -hex 32
AUDIT_HMAC_KEY=replace_with_min_32_char_random_audit_hmac_key_123456

# Cookie SameSite Policy ('strict' | 'lax' | 'none')
# In production with Vercel frontend + Render backend (cross-site), 'none' is required for cookies.
COOKIE_SAMESITE=none

# Storage Driver ('memory' | 'disk' | 's3')
# On Render: Use 'disk' with a Persistent Disk Mount (e.g. ./data/blobs mounted at /var/data)
STORAGE_DRIVER=disk
STORAGE_DIR=./data/blobs

# S3 Configuration (Required only if STORAGE_DRIVER=s3)
# S3_BUCKET=cipher-vault-encrypted-blobs
# S3_REGION=us-east-1
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com

# Operational Limits & Rate Limiting
RATE_LIMIT_MAX=30
MAX_UPLOAD_BYTES=26214400
MAX_DECOMPRESSED_BYTES=104857600
GEO_MAX_ACCURACY_METERS=500
UNLOCK_MAX_PER_15MIN=10

# Multi-Channel Breach Alerting - SMTP Email (Optional)
# Dispatches security breach notices if failed unlock attempts occur
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your_sendgrid_api_key
# SMTP_FROM=security@ciphervault.io

# Multi-Channel Breach Alerting - Twilio SMS (Optional)
# Dispatches instant SMS alerts if 3 failed unlock attempts trigger self-destruct
# TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_FROM_PHONE=+15551234567
