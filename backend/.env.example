# Environment Configuration for Cipher Vault Backend
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/cipher_vault
CLIENT_ORIGIN=http://localhost:3000

# Security Secrets (Must be at least 32 characters; MFA key must be exactly 64 hex characters)
JWT_ACCESS_SECRET=replace_with_min_32_char_random_access_secret_123456
JWT_REFRESH_SECRET=replace_with_min_32_char_random_refresh_secret_12345
MFA_ENC_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
AUDIT_HMAC_KEY=replace_with_min_32_char_random_audit_hmac_key_123456

# Operational Limits
RATE_LIMIT_MAX=30
MAX_UPLOAD_BYTES=26214400
MAX_DECOMPRESSED_BYTES=104857600

# Storage Driver ('memory' | 'disk' | 's3')
# NOTE: The legacy variable AWS_S3_BUCKET_NAME is OBSOLETE and NOT used.
# Use STORAGE_DRIVER, STORAGE_DIR, S3_BUCKET, S3_REGION, and S3_ENDPOINT below:
STORAGE_DRIVER=disk
STORAGE_DIR=./data/blobs

# S3 Configuration (Required if STORAGE_DRIVER=s3)
# S3_BUCKET=cipher-vault-blobs
# S3_REGION=us-east-1
# S3_ENDPOINT=http://127.0.0.1:9000

# Geofence & Rate Limiting Thresholds
GEO_MAX_ACCURACY_METERS=500
UNLOCK_MAX_PER_15MIN=10
